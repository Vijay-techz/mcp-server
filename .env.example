# Kubernetes API access
KUBERNETES_API_SERVER=https://kubernetes.default.svc
KUBERNETES_SERVICE_ACCOUNT_TOKEN=
KUBERNETES_SERVICE_ACCOUNT_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
KUBERNETES_SERVICE_ACCOUNT_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
KUBERNETES_CA_CERT_PATH=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt

# Optional: if using a local kubeconfig instead of in-cluster auth
# KUBECONFIG=/path/to/config
